// ─── Generator & Datasource ──────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  OWNER
  MANAGER
  RECEPTIONIST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
  DELUXE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT  — core of the SaaS: every hotel/venue is a tenant
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique           // e.g. "hilton-cairo"
  location    String?
  phone       String?
  email       String?
  logo        String?                      // URL to logo image

  // Relations
  users       User[]
  staff       Staff[]
  rooms       Room[]
  customers   Customer[]
  bookings    Booking[]

  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// USER  — authenticated accounts (hotel owners / admins logging into the SaaS)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(USER)

  // Relations
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  bookings  Booking[]

  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// STAFF  — hotel employees (receptionists, managers, etc.)
// ─────────────────────────────────────────────────────────────────────────────

model Staff {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(RECEPTIONIST)
  phone     String?

  // Relations
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER  — hotel guests who make bookings
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String
  phone     String?
  address   String?

  // Relations
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  bookings  Booking[]
  reviews   Review[]

  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // email is unique per tenant, not globally
  @@unique([tenantId, email])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ROOM  — bookable rooms inside a tenant's hotel
// ─────────────────────────────────────────────────────────────────────────────

model Room {
  id          String      @id @default(uuid())
  roomNumber  String
  type        RoomType    @default(SINGLE)
  price       Decimal     @db.Decimal(10, 2)   // price per night
  capacity    Int         @default(1)
  description String?
  status      RoomStatus  @default(AVAILABLE)

  // Relations
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  bookings    Booking[]
  images      RoomImage[]
  reviews     Review[]

  isDeleted   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // room number is unique per tenant
  @@unique([tenantId, roomNumber])
  @@index([tenantId])
  @@index([tenantId, status])        // fast availability queries
}

// ─────────────────────────────────────────────────────────────────────────────
// ROOM IMAGE  — multiple images per room
// ─────────────────────────────────────────────────────────────────────────────

model RoomImage {
  id        String   @id @default(uuid())
  imageUrl  String
  isPrimary Boolean  @default(false)

  // Relations
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())

  @@index([roomId])
}

// ─────────────────────────────────────────────────────────────────────────────
// BOOKING  — a reservation linking customer ↔ room ↔ tenant
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id          String        @id @default(uuid())
  checkIn     DateTime
  checkOut    DateTime
  totalPrice  Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)
  notes       String?

  // Relations
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])

  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])

  roomId      String
  room        Room          @relation(fields: [roomId], references: [id])

  userId      String                          // staff member who created it
  user        User          @relation(fields: [userId], references: [id])

  payment     Payment?
  
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // key index: prevents double-booking + fast tenant queries
  @@index([tenantId, roomId, checkIn, checkOut])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENT  — one payment per booking
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id         String        @id @default(uuid())
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod @default(CASH)
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  notes      String?

  // Relations — one-to-one with Booking
  bookingId  String        @unique
  booking    Booking       @relation(fields: [bookingId], references: [id])

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([bookingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// REVIEW  — customer review for a room after checkout
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(uuid())
  rating     Int                            // 1–5
  comment    String?

  // Relations
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])

  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // one review per customer per room
  @@unique([customerId, roomId])
  @@index([tenantId])
  @@index([roomId])
}
